# OPTIONAL: canonical origin for a self-hosted deployment. Feeds canonical
# links, robots, sitemap and every share-card image URL. Unset keeps
# https://gitdiagram.com.
NEXT_PUBLIC_SITE_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
CACHE_KEY_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

OPENAI_API_KEY=
# OPTIONAL: choose which provider to use for generation: openai | openrouter
AI_PROVIDER=openai
# OPTIONAL: model used for both generation stages when AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-luna
# OPTIONAL: base URL of an OpenAI-compatible gateway, ending in /v1. Unset
# talks to api.openai.com.
OPENAI_BASE_URL=
# OPTIONAL: how a gateway reaches the model. `responses` is the OpenAI Responses
# API, which also provides exact input-token counts and service tiers. `chat`
# uses Chat Completions, for gateways that expose only /v1/chat/completions.
# Ignored when AI_PROVIDER=openrouter.
AI_API_STYLE=responses
# OPTIONAL: user-selectable models served by an OpenAI-compatible gateway that
# only speaks /v1/chat/completions (e.g. a Cloudflare AI Console deployment).
# GATEWAY_BASE_URL ends in /v1; GATEWAY_MODEL_ALLOWLIST is a comma-separated
# list of model ids the selector may request. A gateway model requires the
# caller's own API key and is billed by the gateway, never by GitDiagram's
# complimentary quota. Unset or empty allowlist disables the selector entirely.
GATEWAY_BASE_URL=
GATEWAY_MODEL_ALLOWLIST=

# OPTIONAL: token that unlocks the hidden sponsor editor at /admin/sponsors.
# Generate one with `openssl rand -hex 32`. Unset means every read and write on
# /api/admin/sponsors is rejected, and the sponsor slots keep showing the
# "你的公司" placeholder.
SPONSOR_ADMIN_TOKEN=
# OPTIONAL: JSON object merged into every Chat Completions request body, for
# gateway-specific fields this app cannot know about. The common one silences a
# reasoning model that otherwise spends the whole budget on hidden thinking:
# AI_CHAT_EXTRA_PARAMS={"chat_template_kwargs":{"enable_thinking":false}}
AI_CHAT_EXTRA_PARAMS=
# OPTIONAL: USD per million tokens for a model id missing from the built-in
# price table, which gateway-hosted models usually are. Both rates are required:
# without them the model is rejected as unpriceable rather than billed as free.
MODEL_PRICING_INPUT_USD_PER_MILLION=
MODEL_PRICING_OUTPUT_USD_PER_MILLION=
# OPTIONAL: enable a daily complimentary-token cap. Leave false to use the
# server account's available credits without an application daily quota.
OPENAI_COMPLIMENTARY_GATE_ENABLED=false
OPENAI_COMPLIMENTARY_DAILY_LIMIT_TOKENS=10000000
OPENAI_COMPLIMENTARY_MODEL_FAMILY=gpt-5.6-luna
# OPTIONAL: per-IP throttle for generations billed to the server's own key.
# Callers supplying their own API key are not throttled.
GENERATION_RATE_LIMIT_MAX=8
GENERATION_RATE_LIMIT_WINDOW_SECONDS=3600
# OPTIONAL: OpenRouter credentials/model when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-terra
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=GitDiagram
NEXT_PUBLIC_POSTHOG_KEY=
# Server-only query-read key for the sponsor page's five-minute audience cache.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=113380

# OPTIONAL: providing one or more GitHub PATs increases GitHub API rate limits.
GITHUB_PAT=
GITHUB_PATS=
# OPTIONAL: GitHub App auth (used when GITHUB_PAT is not provided)
# Either GITHUB_APP_ID or GITHUB_CLIENT_ID can be used as the GitHub App JWT issuer.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
